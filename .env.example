# =============================================================================
# FoodSaver environment variables
#
# Copy this file to `.env.local` for local dev, and set the same values in your
# Vercel project settings for preview + production. Only the `NEXT_PUBLIC_*`
# variables are exposed to the browser bundle; everything else is server-only.
# =============================================================================

# ---- Public site URL ---------------------------------------------------------
# Used by `metadataBase`, robots.ts, sitemap.ts, and JSON-LD. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://foodsaverph.com


# ---- Supabase ----------------------------------------------------------------
# Public anon key is safe to ship to the client (RLS enforces access). The
# service role key bypasses RLS and is used only by server routes + the cron
# sweep; NEVER expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://oavgquwjvbzrgqpoufgx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_SERVICE_ROLE_KEY=


# ---- Vercel Cron -------------------------------------------------------------
# `CRON_SECRET` gates `/api/admin/no-show-sweep`. Vercel sets an `Authorization:
# Bearer <value>` header on scheduled hits — set the same value here. Generate
# a random string, don\u2019t share it.
CRON_SECRET=


# ---- Semaphore SMS (Philippines) ---------------------------------------------
# Used for reservation confirmation / fee rejection / pickup completion SMS.
# Sign up at semaphore.co. Graceful no-op when unset.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=FoodSaver


# ---- Resend (transactional email) --------------------------------------------
# Optional but recommended. Used for the "your reservation is confirmed" email
# to buyers and new-order notification to merchants.
RESEND_API_KEY=


# ---- PostHog analytics -------------------------------------------------------
# Optional. When unset, all `track()` calls are no-ops — no bundle cost beyond
# the tiny wrapper in `src/lib/analytics.ts`.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
