<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <!-- Background -->
  <rect width="512" height="512" fill="#2B3A2B"/>

  <!-- Leaf/Food Icon -->
  <g transform="translate(256, 200)">
    <!-- Leaf shape -->
    <path d="M 0,-90 Q 50,-120 65,-50 Q 50,30 0,80 Q -50,30 -65,-50 Q -50,-120 0,-90 Z" fill="#C9A84C"/>
    <!-- Leaf vein -->
    <line x1="0" y1="-90" x2="0" y2="80" stroke="#2B3A2B" stroke-width="4"/>
  </g>

  <!-- Text: FS -->
  <text x="256" y="400" font-family="Arial, sans-serif" font-size="110" font-weight="bold" fill="#F5F0E8" text-anchor="middle" dominant-baseline="middle">FS</text>
</svg>