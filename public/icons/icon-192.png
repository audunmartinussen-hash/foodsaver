<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 192 192" width="192" height="192">
  <!-- Background -->
  <rect width="192" height="192" fill="#2B3A2B"/>

  <!-- Leaf/Food Icon -->
  <g transform="translate(96, 80)">
    <!-- Leaf shape -->
    <path d="M 0,-35 Q 20,-45 25,-20 Q 20,10 0,30 Q -20,10 -25,-20 Q -20,-45 0,-35 Z" fill="#C9A84C"/>
    <!-- Leaf vein -->
    <line x1="0" y1="-35" x2="0" y2="30" stroke="#2B3A2B" stroke-width="2"/>
  </g>

  <!-- Text: FS -->
  <text x="96" y="140" font-family="Arial, sans-serif" font-size="42" font-weight="bold" fill="#F5F0E8" text-anchor="middle" dominant-baseline="middle">FS</text>
</svg>