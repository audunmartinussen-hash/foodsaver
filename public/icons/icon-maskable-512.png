<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <!-- Background -->
  <rect width="512" height="512" fill="#2B3A2B"/>

  <!-- Leaf/Food Icon with extra padding for maskable -->
  <g transform="translate(256, 210)">
    <!-- Leaf shape - centered with padding -->
    <path d="M 0,-75 Q 42,-100 54,-42 Q 42,25 0,65 Q -42,25 -54,-42 Q -42,-100 0,-75 Z" fill="#C9A84C"/>
    <!-- Leaf vein -->
    <line x1="0" y1="-75" x2="0" y2="65" stroke="#2B3A2B" stroke-width="3"/>
  </g>

  <!-- Text: FS - slightly smaller for maskable safety zone -->
  <text x="256" y="385" font-family="Arial, sans-serif" font-size="90" font-weight="bold" fill="#F5F0E8" text-anchor="middle" dominant-baseline="middle">FS</text>
</svg>